{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remember Me",
  "version": "0.1.4",
  "identifier": "com.rememberme.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Remember Me?",
        "width": 420,
        "height": 620,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "category": "Utility",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/remember-me.desktop",
        "recommends": [
          "gstreamer1.0-plugins-good",
          "gnome-shell-extension-appindicator"
        ]
      },
      "rpm": {
        "desktopTemplate": "linux/remember-me.desktop",
        "recommends": [
          "gstreamer1-plugins-good",
          "gnome-shell-extension-appindicator"
        ]
      }
    }
  }
}
